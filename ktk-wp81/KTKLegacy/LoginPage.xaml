<phone:PhoneApplicationPage
    x:Class="KTKLegacy.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <StackPanel Grid.Row="0" Margin="24,32,24,12">
            <TextBlock Text="КТК" Style="{StaticResource PhoneTextTitle1Style}"
                       FontSize="72" FontWeight="Bold"
                       Foreground="{StaticResource PhoneAccentBrush}"/>
            <TextBlock Text="Электронный журнал" Style="{StaticResource PhoneTextSubtleStyle}"
                       FontSize="20" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="1" Margin="16,8,16,16"
                Background="{StaticResource PhoneChromeBrush}"
                CornerRadius="12" Padding="20">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Логин" Style="{StaticResource PhoneTextSmallStyle}" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginBox"
                         InputScope="EmailNameOrAddress"
                         MaxLength="128"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" Style="{StaticResource PhoneTextSmallStyle}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             MaxLength="256"
                             KeyDown="PasswordBox_KeyDown"
                             Margin="0,0,0,16"/>

                <Button x:Name="SignInButton"
                        Content="Войти"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource PhoneAccentBrush}"
                        Foreground="White"
                        Click="SignInButton_Click"/>

                <ProgressBar x:Name="Progress"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Height="4" Margin="0,8,0,0"/>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#FFE74C3C"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</phone:PhoneApplicationPage>
