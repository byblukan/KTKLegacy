# BearSSL sources: only the files the KTK core links (computed with tools/ktk-cli on 32- and 64-bit
# builds; files for other CPUs compile to nothing). Plain C, MIT licence (third_party/bearssl).
INCLUDEPATH += $$PWD/third_party/bearssl/inc $$PWD/third_party/bearssl/src
